# ---------------------------------------------------------------------------
# ScreenToStream Concierge
# Copy to .env, then set PUBLIC_BASE_URL to the URL Alexa+ / the browser uses.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
# Demo surfaces (simulator, viewing feed, reset, frame upload) are enabled for
# the judge path. Production refuses to start with DEMO_MODE=true unless
# ALLOW_DEMO_IN_PRODUCTION=true is set on an isolated, protected host.
DEMO_MODE=true
ALLOW_DEMO_IN_PRODUCTION=false

# Optional HTTP Basic protection for the simulator and demo APIs. The MCP
# endpoint stays on OAuth bearer auth and is never covered by this prompt.
# Set both values or neither.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=
# Per-IP fixed window for demo control routes. 0 disables it.
DEMO_RATE_LIMIT_PER_MINUTE=60
# Trust CF-Connecting-IP / X-Forwarded-For only when a trusted tunnel or load
# balancer sets them. Leave false for direct internet exposure.
TRUST_PROXY_HEADERS=false
# One structured JSON access-log line per request (never logs query strings).
ACCESS_LOG_ENABLED=true

# Local URL. For a tunnel, use the public HTTPS URL, e.g.
#   PUBLIC_BASE_URL=https://your-name.trycloudflare.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
INTERNAL_MCP_URL=http://127.0.0.1:8000/mcp
HOST=0.0.0.0
PORT=8000
# Extra Host header values accepted by TrustedHostMiddleware, e.g. a LAN IP.
# PUBLIC_BASE_URL's host, localhost, and 127.0.0.1 are always accepted.
ALLOWED_HOSTS=

# Stable signing key. Leave blank locally to use runtime/dev-secret.key.
# Production: SECRET_KEY is required and must be at least 32 characters; the
# server exits instead of falling back to a generated file.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Comma/space separated previous keys accepted during a rotation overlap.
SECRET_KEY_PREVIOUS=

DATABASE_PATH=runtime/concierge.db
RUNTIME_DIR=runtime
# Uploaded frames are served through short-lived HMAC-signed URLs.
FRAME_URL_TTL_SECONDS=900

# OAuth clients. Alexa+ does not use dynamic client registration here, so the
# client IDs are provisioned in the server configuration.
ALEXA_CLIENT_ID=alexa-plus-client
ALEXA_REDIRECT_URIS=
SIMULATOR_CLIENT_ID=screentostream-simulator

# Optional exact client registry JSON. If set, it replaces the built-in clients.
# Confidential clients must include a secret and public=false; they can use
# client_secret_basic or client_secret_post at the token/revocation endpoints.
# OAUTH_CLIENTS_JSON={"alexa-plus-client":{"name":"Alexa+","public":true,"redirect_uris":["https://example.com/auth/callback"]}}
# OAUTH_CLIENTS_JSON={"partner":{"name":"Partner","public":false,"client_secret":"change-me","redirect_uris":["https://partner.example/callback"]}}

# ---------------------------------------------------------------------------
# Models. Amazon Bedrock is preferred when enabled. With no Bedrock
# credentials and no fallback keys, the deterministic catalog/rules path is
# used and the simulator badges show "fallback".
# ---------------------------------------------------------------------------
LLM_MODE=auto

# AWS Bedrock Runtime (AWS Builder Mini Challenge integration).
# auto = use Bedrock when standard AWS credential markers or a short-term
# Bedrock API key are present.
# live = force Bedrock; off = use DeepSeek/MiniMax instead.
BEDROCK_MODE=auto
AWS_REGION=us-east-1
# Optional short-term Bedrock API key from the Bedrock console (API keys).
# Leave empty to use the standard AWS credential chain instead. Never commit
# a real token.
AWS_BEARER_TOKEN_BEDROCK=
# Use the exact model or inference-profile ID enabled in your account.
# The default is the current global Claude Sonnet 4.6 inference profile.
BEDROCK_TEXT_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_VISION_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Nova Canvas is native 16:9; Titan v1 remains supported.
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
BEDROCK_IMAGE_QUALITY=standard
# 0 lets the adapter choose dimensions from the image model.
BEDROCK_IMAGE_WIDTH=0
BEDROCK_IMAGE_HEIGHT=0
# Standard AWS credential chain is used. For local setup, run `aws configure`
# and set BEDROCK_MODE=live if you rely on a shared profile.

# Optional fallback adapters (used when BEDROCK_MODE=off).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_VISION_MODEL=MiniMax-M3.1-Flash
MINIMAX_IMAGE_MODEL=image-01

PROVIDER_TIMEOUT_SECONDS=40
PROVIDER_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Latency and simulator controls. The MCP hot path is deterministic; the
# reasoning provider writes narrative in the background and the result is
# cached speculatively.
# ---------------------------------------------------------------------------
PLANNER_WAIT_MS=400
PREFETCH_ON_SCENE=true
CACHE_TTL_SECONDS=43200
SIMULATOR_AGENT=auto
SIMULATOR_MAX_TOOL_ROUNDS=6
